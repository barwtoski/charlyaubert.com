---
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} — Nila</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, 'https://charlyaubert.com')} />
  </head>
  <body>
    <header><a href="/nila-google/" aria-label="Nila, présentation">Nila</a><span>Une application de Charly Aubert</span></header>
    <main><slot /></main>
    <footer><a href="/nila-google/">Présentation</a><a href="/nila-google/confidentialite/">Confidentialité</a><a href="mailto:orion.aubert@gmail.com">Contacter Charly</a></footer>
  </body>
</html>
<style is:global>
  :root { font-family: system-ui, sans-serif; color: #182e2b; background: #f7f7f2; line-height: 1.7; color-scheme: light; }
  * { box-sizing: border-box; }
  body { margin: 0; }
  header, main, footer { max-width: 800px; margin: auto; padding: 28px clamp(20px, 5vw, 48px); }
  header { display: flex; gap: 16px; flex-wrap: wrap; align-items: baseline; border-bottom: 1px solid #d4ddd6; }
  header a { font-size: 1.5rem; font-weight: 750; text-decoration: none; }
  header span, .date { font-size: .9rem; color: #52645f; }
  main { padding-top: 48px; padding-bottom: 48px; }
  h1 { font-size: clamp(2rem, 6vw, 3rem); line-height: 1.15; margin: 0 0 24px; letter-spacing: -.03em; }
  h2 { font-size: 1.35rem; line-height: 1.35; margin: 40px 0 14px; }
  p, ul, ol { margin: 0 0 18px; }
  ul, ol { padding-left: 24px; }
  li { margin-bottom: 8px; }
  a { color: #145c4e; text-underline-offset: 3px; overflow-wrap: anywhere; }
  a:focus-visible { outline: 3px solid #a1630b; outline-offset: 4px; }
  .intro { font-size: 1.2rem; }
  .note { padding: 20px; border-left: 4px solid #50806a; background: #e9eee7; }
  footer { border-top: 1px solid #d4ddd6; display: flex; flex-wrap: wrap; gap: 12px 24px; font-size: .95rem; }
</style>
